# 复制为 .env 后按本机/部署环境修改，.env 不进仓库

PORT=8080

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=mallsss
PGUSER=postgres
PGPASSWORD=

# 阿里云 OSS（客户端直传用，服务端只做预签名与元数据确认）
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 管理后台会话 Cookie（本地 HTTP 不要开 Secure）
COOKIE_SECURE=false
ADMIN_ORIGIN=http://localhost:5174

# 首个超级管理员种子（accounts 为空时创建一次，口令勿提交仓库）
SEED_SUPER_ADMIN_LOGIN=admin
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123

